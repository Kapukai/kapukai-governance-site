[Unit]
Description=Verify and publish Kapukai community pages in their dedicated static overlay
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -E -s -B /usr/local/lib/kapukai-branded-sync/sync.py sync
TimeoutStartSec=12min
UMask=0022
ProtectSystem=strict
ReadWritePaths=/srv/kapukai-branded-sync /var/lib/kapukai-branded-sync/overlay
InaccessiblePaths=-/var/www -/etc/nginx -/run/nginx.pid -/run/systemd/private -/run/dbus/system_bus_socket
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=~@privileged @mount @debug kill tkill tgkill pidfd_send_signal rt_sigqueueinfo rt_tgsigqueueinfo
SystemCallErrorNumber=EPERM
LockPersonality=true
