{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "redirects": [
    {"source": "/", "destination": "/evidence/", "permanent": false},
    {"source": "/evidence", "destination": "/evidence/", "permanent": true}
  ],
  "headers": [{"source": "/evidence/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"},
    {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
  ]}]
}
